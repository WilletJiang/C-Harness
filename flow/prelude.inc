"(input => {\n"
"    'use strict';\n"
"    const stringify = JSON.stringify;\n"
"    const AsyncFunction = Object.getPrototypeOf(async function(){}).constructor;\n"
"    const tools = Object.create(null);\n"
"    const history = input.history, waves = input.waves;\n"
"    let issued = 0, wave = 0, pending = [], settled = false, outcome;\n"
"    // Replaying starts in a fresh realm. Expose no wall clock, entropy or timers.\n"
"    delete globalThis.Atomics;\n"
"    delete globalThis.SharedArrayBuffer;\n"
"    delete globalThis.Date;\n"
"    delete Math.random;\n"
"    delete globalThis.WeakRef;\n"
"    delete globalThis.FinalizationRegistry;\n"
"    const fault = msg => stringify({error: String(msg).slice(0, 2048)});\n"
"    for (const name of input.names) {\n"
"        tools[name] = (args = {}) => {\n"
"            if (issued >= 32) throw new Error('flow child limit exceeded');\n"
"            const key = 'c' + issued++;\n"
"            // Snapshot arguments when called, before user code can mutate them.\n"
"            const encoded = stringify(args);\n"
"            return new Promise((resolve, reject) => {\n"
"                pending.push({key, name, encoded, resolve, reject});\n"
"            });\n"
"        };\n"
"    }\n"
"    Object.freeze(tools);\n"
"    const program = new AsyncFunction('tools', '\"use strict\";\\n' + input.script);\n"
"    program(tools).then(value => {\n"
"        outcome = stringify({value: value === undefined ? null : value}); settled = true;\n"
"    }).catch(err => {outcome = fault(err); settled = true;});\n"
"    let waiting;\n"
"    return (wake) => {\n"
"        if (waiting) {\n"
"            for (const c of waiting) {\n"
"                const row = wake.calls[c.key];\n"
"                if (!row || row.status !== 'done') return fault('unsettled flow result');\n"
"                if (row.is_error) c.reject(new Error(stringify(row.result)));\n"
"                else c.resolve(row.result);\n"
"            }\n"
"            waiting = undefined;\n"
"            return;\n"
"        }\n"
"        if (settled) {\n"
"            if (pending.length) return fault('flow returned with unawaited tool calls');\n"
"            if (wave !== waves.length) return fault('flow replay diverged');\n"
"            return outcome;\n"
"        }\n"
"        if (!pending.length) return fault('flow is waiting without a tool call');\n"
"        const calls = pending; pending = [];\n"
"        if (wave === waves.length) {\n"
"            waiting = calls;\n"
"            return stringify({calls:calls.map(c => ({key:c.key,tool:c.name,arguments:JSON.parse(c.encoded)}))});\n"
"        }\n"
"        if (calls.length !== waves[wave++]) return fault('flow replay batch changed');\n"
"        for (const c of calls) {\n"
"            const row = history[c.key];\n"
"            if (!row || row.name !== c.name || stringify(row.args) !== c.encoded)\n"
"                return fault('flow replay call changed');\n"
"            if (row.failed) c.reject(new Error(stringify(row.result)));\n"
"            else c.resolve(row.result);\n"
"        }\n"
"    };\n"
"})\n"
